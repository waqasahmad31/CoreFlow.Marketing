---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page, merged alongside the site-wide Organization schema. */
  structuredData?: Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData = [] } = Astro.props;
// Read from `site` in astro.config.mjs so the canonical URL, OG tags and the
// generated sitemap can never disagree. Changing the domain is a one-line edit
// there; the fallback only applies if `site` is unset.
const siteUrl = Astro.site ?? new URL('https://coreflow.netlify.app');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/og-default.svg', siteUrl);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CoreFlow',
  url: siteUrl,
  logo: new URL('/images/coreflow-icon.svg', siteUrl).toString(),
  description:
    'CoreFlow is a business ERP (CRM, Inventory, Sales, Procurement, Finance, Approvals) built for growing SMEs.',
};

const allSchemas = [organizationSchema, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!--
      Google Search Console verification: TODO(owner) — once the site is
      live on a real domain, add the site in Search Console and replace
      REPLACE_WITH_REAL_VERIFICATION_CODE with the code it gives you (or use
      the DNS-verification method instead and remove this tag entirely).
    -->
    <meta name="google-site-verification" content="REPLACE_WITH_REAL_VERIFICATION_CODE" />

    <title>{title} · CoreFlow</title>
    <meta name="description" content={description} />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · CoreFlow`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=IBM+Plex+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!--
      Analytics is intentionally absent. A placeholder beacon token loads the
      script, reports to no dashboard and throws a CORS error in every
      visitor's console — worse than no analytics at all.

      To enable Cloudflare Web Analytics (free, cookie-less, no DNS change):
      register the site at https://www.cloudflare.com/web-analytics/ and add
      the beacon script here with the real token. Netlify Analytics is the
      other option and needs no page change at all.
    -->
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
