---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page, merged alongside the site-wide Organization schema. */
  structuredData?: Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData = [] } = Astro.props;
const siteUrl = 'https://coreflow.example';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/og-default.svg', siteUrl);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CoreFlow',
  url: siteUrl,
  logo: new URL('/images/coreflow-icon.svg', siteUrl).toString(),
  description:
    'CoreFlow is a business ERP (CRM, Inventory, Sales, Procurement, Finance, Approvals) built for growing SMEs.',
};

const allSchemas = [organizationSchema, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!--
      Google Search Console verification: TODO(owner) — once the site is
      live on a real domain, add the site in Search Console and replace
      REPLACE_WITH_REAL_VERIFICATION_CODE with the code it gives you (or use
      the DNS-verification method instead and remove this tag entirely).
    -->
    <meta name="google-site-verification" content="REPLACE_WITH_REAL_VERIFICATION_CODE" />

    <title>{title} · CoreFlow</title>
    <meta name="description" content={description} />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · CoreFlow`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=IBM+Plex+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!--
      Cloudflare Web Analytics — free, cookie-less, privacy-respecting.
      REPLACE_WITH_REAL_TOKEN below with the real beacon token once the owner
      creates a free Cloudflare account and registers this site at
      https://www.cloudflare.com/web-analytics/ (no DNS/domain change
      required — it's a JS beacon, works on any host). Until replaced, this
      script loads but reports to no real dashboard.
    -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_REAL_TOKEN"}'
    ></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
